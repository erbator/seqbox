#version 300 es
// digital vibrance: boosts saturation, more for dull colors than already-vivid ones
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

const float VIBRANCE = @VIBRANCE@;

void main() {
    vec4 color = texture(tex, v_texcoord);
    float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
    float sat = max(color.r, max(color.g, color.b)) - min(color.r, min(color.g, color.b));
    vec3 boosted = mix(vec3(luma), color.rgb, 1.0 + VIBRANCE * (1.0 - sat));
    fragColor = vec4(clamp(boosted, 0.0, 1.0), color.a);
}
